PORT=8000

# Shared MongoDB Atlas/cluster connection string.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<default_db>?retryWrites=true&w=majority

# Player attempt/session snapshot storage.
PLAYER_DB_NAME=promptwars
PLAYER_COLLECTION_NAME=playerDetails2

# Employee directory lookup. This can point to a different DB in the same cluster.
EMPLOYEE_DB_NAME=promptwars
EMPLOYEE_COLLECTION_NAME=employeeDetails
COMPANY_EMAIL_DOMAIN=calfus.com

# Live session storage.
# auto = Redis when REDIS_URL is set, otherwise MongoDB when MONGO_URI is set, otherwise in-memory.
SESSION_STORE=auto
SESSION_DB_NAME=promptwars
SESSION_COLLECTION_NAME=gameSessions
SESSION_BINDINGS_COLLECTION_NAME=sessionBindings
REDIS_URL=

# Game/evaluator dependencies.
OPENAI_API_KEY=
ADMIN_NAME=admin
ADMIN_EMAIL=admin@prompt.com
ADMIN_TOKEN_SECRET=replace-this-in-production
